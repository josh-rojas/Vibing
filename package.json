{
  "name": "vibing-website",
  "version": "0.1.3",
  "description": "Documentation and landing page website for Vibing - a voice input desktop application for macOS and Windows",
  "main": "index.html",
  "scripts": {
    "dev": "npx http-server -p 8080 -o",
    "validate": "html-validate *.html",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "test": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VibingJustSpeakIt/Vibing.git"
  },
  "keywords": [
    "voice-input",
    "speech-to-text",
    "ai",
    "transcription",
    "multilingual",
    "llm"
  ],
  "author": "VibingJustSpeakIt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VibingJustSpeakIt/Vibing/issues"
  },
  "homepage": "https://vibingjustspeakit.github.io/Vibing/",
  "devDependencies": {
    "html-validate": "^8.0.0",
    "http-server": "^14.1.1",
    "prettier": "^3.0.0"
  }
}
